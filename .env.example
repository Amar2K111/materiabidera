# =============================================================================
# MateriaBTP — variables d'environnement
# Copier ce fichier en .env.local puis renseigner les valeurs.
#
# NE JAMAIS mettre de vraie valeur ici : ce fichier est suivi par Git et
# publie sur le depot. Seul .env.local, ignore par Git, contient les secrets.
# Aucune cle secrete ne doit porter le prefixe NEXT_PUBLIC_.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon
# Cle de service : SERVEUR UNIQUEMENT. Contourne les policies RLS.
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# --- Fournisseur IA -----------------------------------------------------------
# Selectionne l'adaptateur utilise par la couche IA : "gemini" | "anthropic"
AI_PROVIDER=gemini
GEMINI_API_KEY=votre_cle_gemini
ANTHROPIC_API_KEY=

# --- Stripe (prepare, non requis en V1) ---------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Application --------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
